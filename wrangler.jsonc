{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "haleverse-website",
  "main": "./worker/index.js",
  "compatibility_date": "2026-07-12",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./site-build",
    "binding": "ASSETS",
    "run_worker_first": [
      "/diagnostico",
      "/diagnostico/*",
      "/diagnostico-proxy/*",
      "/api/diagnostic/*"
    ],
    "not_found_handling": "single-page-application"
  }
}
